---
import Icon from './Icon.astro';
interface Props {
  title: string;
  subtitle?: string;
  crumb: string;
}
const { title, subtitle, crumb } = Astro.props;
---
<section class="relative overflow-hidden bg-brand-950 text-white">
  <div class="absolute inset-0 bg-grid opacity-60"></div>
  <div class="absolute -right-24 -top-24 h-72 w-72 rounded-full bg-accent-500/10 blur-3xl"></div>
  <div class="container-x relative py-16 lg:py-20">
    <nav aria-label="Breadcrumb" class="mb-4 flex items-center gap-2 text-sm text-brand-200">
      <a href="/" class="hover:text-accent-400">Home</a>
      <Icon name="arrow" class="h-3.5 w-3.5 text-brand-400" />
      <span class="text-accent-400">{crumb}</span>
    </nav>
    <h1 class="max-w-3xl text-4xl font-bold tracking-tight text-balance sm:text-5xl">{title}</h1>
    {subtitle && <p class="mt-4 max-w-2xl text-lg leading-relaxed text-brand-100">{subtitle}</p>}
  </div>
</section>
