---
import Button from './Button.astro';
import { CONTACT } from '../consts';
interface Props {
  title?: string;
  text?: string;
}
const {
  title = 'Have a project in mind? Let’s build it right.',
  text = 'From rural connectivity to highways and turnkey EPC contracts, our team is ready to deliver — on spec, on budget, on time.',
} = Astro.props;
---
<section class="relative overflow-hidden bg-brand-900">
  <div class="absolute inset-0 bg-grid opacity-60"></div>
  <div class="absolute -right-24 -top-24 h-80 w-80 rounded-full bg-accent-500/10 blur-3xl"></div>
  <div class="container-x relative py-16 lg:py-20">
    <div class="flex flex-col items-start justify-between gap-8 lg:flex-row lg:items-center">
      <div class="max-w-2xl">
        <h2 class="text-3xl text-balance text-white sm:text-4xl">{title}</h2>
        <p class="mt-4 text-lg leading-relaxed text-brand-100">{text}</p>
      </div>
      <div class="flex flex-shrink-0 flex-col gap-3 sm:flex-row">
        <Button href="/contact/" variant="primary" size="lg" arrow>Request a Quote</Button>
        <Button href={CONTACT.phoneHref} variant="white" size="lg">Call {CONTACT.phone}</Button>
      </div>
    </div>
  </div>
</section>
