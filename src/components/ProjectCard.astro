---
import Icon from './Icon.astro';
import type { Project } from '../data/content';
interface Props { project: Project; featured?: boolean }
const { project, featured = false } = Astro.props;

// Category → icon + visual treatment for the placeholder image band.
const map: Record<Project['category'], { icon: any; from: string; to: string }> = {
  Highway:        { icon: 'highway', from: 'from-brand-800', to: 'to-brand-950' },
  'RCC Road':     { icon: 'rcc',     from: 'from-brand-700', to: 'to-brand-900' },
  'Rural Road':   { icon: 'road',    from: 'from-brand-600', to: 'to-brand-800' },
  EPC:            { icon: 'epc',     from: 'from-brand-800', to: 'to-brand-950' },
  Bridge:         { icon: 'bridge',  from: 'from-brand-700', to: 'to-brand-900' },
  'Cement Plant': { icon: 'epc',     from: 'from-brand-800', to: 'to-brand-950' },
};
const v = map[project.category];
---
<article class={`reveal group flex flex-col overflow-hidden rounded-2xl border border-slate-200 bg-white shadow-card transition-all duration-300 hover:-translate-y-1 hover:shadow-lift ${featured ? 'lg:col-span-2' : ''}`}>
  <!-- Placeholder image band — replace with a real <img> of the project later -->
  <div class={`relative ${featured ? 'aspect-[2.4/1]' : 'aspect-[16/10]'} bg-gradient-to-br ${v.from} ${v.to} bg-grid overflow-hidden`}>
    <div class="absolute inset-0 opacity-[0.18]">
      <Icon name={v.icon} class="absolute -right-6 -bottom-6 h-44 w-44 text-white" />
    </div>
    <span class="absolute left-4 top-4 rounded-full bg-accent-500 px-3 py-1 text-xs font-semibold text-brand-950">
      {project.category}
    </span>
    {project.highlight && (
      <span class="absolute bottom-4 left-4 flex items-center gap-1.5 rounded-full bg-white/15 px-3 py-1 text-xs font-medium text-white backdrop-blur">
        <Icon name="star" class="h-3.5 w-3.5 text-accent-400" />{project.highlight}
      </span>
    )}
  </div>
  <div class="flex flex-1 flex-col p-6">
    <div class="flex items-center gap-2 text-xs font-medium text-slate-500">
      <Icon name="location" class="h-4 w-4 text-accent-600" />{project.location}
      <span class="text-slate-300">•</span>{project.year}
    </div>
    <h3 class="mt-2 text-lg font-bold text-brand-900">{project.title}</h3>
    <p class="mt-2 flex-1 text-sm leading-relaxed text-slate-600">{project.scope}</p>
    <p class="mt-4 border-t border-slate-100 pt-4 text-xs text-slate-500">
      <span class="font-semibold text-slate-700">Client:</span> {project.client}
    </p>
  </div>
</article>
