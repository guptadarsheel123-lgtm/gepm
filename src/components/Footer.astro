---
import { NAV, CONTACT, SOCIAL, SITE } from '../consts';
import { SERVICES } from '../data/content';
import Icon from './Icon.astro';
import Logo from './Logo.astro';

const year = new Date().getFullYear();
---
<footer class="bg-brand-950 text-brand-100">
  <div class="container-x grid gap-10 py-16 md:grid-cols-2 lg:grid-cols-12 lg:gap-8">
    <!-- Brand -->
    <div class="lg:col-span-4">
      <a href="/" class="flex items-center gap-3" aria-label={`${SITE.name} home`}>
        <Logo class="h-11 w-11" />
        <span class="font-display text-xl font-bold text-white">{SITE.name}</span>
      </a>
      <p class="mt-4 max-w-xs text-sm leading-relaxed text-brand-200">
        {SITE.shortDesc}
      </p>
      <div class="mt-5 flex gap-3">
        <a href={SOCIAL.facebook} aria-label="Facebook" class="rounded-full bg-white/10 p-2.5 transition-colors hover:bg-accent-500 hover:text-brand-950">
          <Icon name="facebook" class="h-4 w-4" />
        </a>
        <a href={SOCIAL.instagram} aria-label="Instagram" class="rounded-full bg-white/10 p-2.5 transition-colors hover:bg-accent-500 hover:text-brand-950">
          <Icon name="instagram" class="h-4 w-4" />
        </a>
        <a href={SOCIAL.linkedin} aria-label="LinkedIn" class="rounded-full bg-white/10 p-2.5 transition-colors hover:bg-accent-500 hover:text-brand-950">
          <Icon name="linkedin" class="h-4 w-4" />
        </a>
      </div>
    </div>

    <!-- Quick links -->
    <div class="lg:col-span-2">
      <h3 class="font-display text-sm font-semibold uppercase tracking-wider text-white">Company</h3>
      <ul class="mt-4 space-y-2.5 text-sm">
        {NAV.map((item) => (
          <li><a href={item.href} class="text-brand-200 transition-colors hover:text-accent-400">{item.label}</a></li>
        ))}
      </ul>
    </div>

    <!-- Services -->
    <div class="lg:col-span-3">
      <h3 class="font-display text-sm font-semibold uppercase tracking-wider text-white">Services</h3>
      <ul class="mt-4 space-y-2.5 text-sm">
        {SERVICES.slice(0, 5).map((s) => (
          <li><a href="/services/" class="text-brand-200 transition-colors hover:text-accent-400">{s.title}</a></li>
        ))}
      </ul>
    </div>

    <!-- Contact -->
    <div class="lg:col-span-3">
      <h3 class="font-display text-sm font-semibold uppercase tracking-wider text-white">Get in touch</h3>
      <ul class="mt-4 space-y-3 text-sm">
        <li class="flex gap-3">
          <Icon name="location" class="mt-0.5 h-4 w-4 shrink-0 text-accent-400" />
          <span class="text-brand-200">{CONTACT.addressLines.join(', ')}</span>
        </li>
        <li class="flex gap-3">
          <Icon name="phone" class="mt-0.5 h-4 w-4 shrink-0 text-accent-400" />
          <a href={CONTACT.phoneHref} class="text-brand-200 hover:text-accent-400">{CONTACT.phone}</a>
        </li>
        <li class="flex gap-3">
          <Icon name="mail" class="mt-0.5 h-4 w-4 shrink-0 text-accent-400" />
          <a href={CONTACT.emailHref} class="text-brand-200 hover:text-accent-400">{CONTACT.email}</a>
        </li>
        <li class="flex gap-3">
          <Icon name="clock" class="mt-0.5 h-4 w-4 shrink-0 text-accent-400" />
          <span class="text-brand-200">{CONTACT.hours}</span>
        </li>
      </ul>
    </div>
  </div>

  <div class="border-t border-white/10">
    <div class="container-x flex flex-col items-center justify-between gap-2 py-6 text-xs text-brand-300 sm:flex-row">
      <p>© {year} {SITE.legalName}. All rights reserved.</p>
      <p>Established {SITE.foundedYear} · Mandsaur, Madhya Pradesh</p>
    </div>
  </div>
</footer>
