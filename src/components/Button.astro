---
import Icon from './Icon.astro';
import { url } from '../lib/url';
interface Props {
  href: string;
  variant?: 'primary' | 'secondary' | 'ghost' | 'white';
  size?: 'md' | 'lg';
  arrow?: boolean;
  class?: string;
}
const { href, variant = 'primary', size = 'md', arrow = false, class: className = '' } = Astro.props;

const base =
  'group inline-flex items-center justify-center gap-2 rounded-full font-semibold transition-all duration-200 focus-visible:outline-2 focus-visible:outline-offset-2';
const sizes = {
  md: 'px-5 py-2.5 text-sm',
  lg: 'px-7 py-3.5 text-base',
};
const variants = {
  primary: 'bg-accent-500 text-brand-950 hover:bg-accent-400 shadow-sm hover:shadow-md',
  secondary: 'bg-brand-900 text-white hover:bg-brand-800',
  ghost: 'text-brand-900 hover:bg-brand-50',
  white: 'bg-white text-brand-900 hover:bg-brand-50 shadow-sm',
};
---
<a href={url(href)} class={`${base} ${sizes[size]} ${variants[variant]} ${className}`}>
  <slot />
  {arrow && <Icon name="arrow" class="w-4 h-4 transition-transform group-hover:translate-x-1" />}
</a>
