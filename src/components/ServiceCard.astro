---
import Icon from './Icon.astro';
import { url } from '../lib/url';
import type { Service } from '../data/content';
interface Props { service: Service }
const { service } = Astro.props;
---
<article class="reveal group relative flex flex-col rounded-2xl border border-slate-200 bg-white p-7 shadow-card transition-all duration-300 hover:-translate-y-1 hover:border-accent-300 hover:shadow-lift">
  <div class="mb-5 inline-flex h-14 w-14 items-center justify-center rounded-xl bg-brand-50 text-brand-700 transition-colors group-hover:bg-accent-500 group-hover:text-brand-950">
    <Icon name={service.icon} class="h-7 w-7" />
  </div>
  <h3 class="text-xl font-bold text-brand-900">{service.title}</h3>
  <p class="mt-2.5 flex-1 text-sm leading-relaxed text-slate-600">{service.short}</p>
  <ul class="mt-5 space-y-2">
    {service.highlights.map((h) => (
      <li class="flex items-center gap-2 text-sm text-slate-700">
        <Icon name="check" class="h-4 w-4 shrink-0 text-accent-600" />{h}
      </li>
    ))}
  </ul>
  <a
    href={url('/services/')}
    class="mt-6 inline-flex items-center gap-1.5 text-sm font-semibold text-brand-700 transition-colors group-hover:text-accent-600"
    aria-label={`Learn more about ${service.title}`}
  >
    Learn more
    <Icon name="arrow" class="h-4 w-4 transition-transform group-hover:translate-x-1" />
  </a>
</article>
