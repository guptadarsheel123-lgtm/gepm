---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE } from '../consts';
import { url } from '../lib/url';

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const {
  title,
  description = SITE.shortDesc,
  image = '/og-image.svg',
} = Astro.props;

const pageTitle = title ? `${title} | ${SITE.name}` : `${SITE.name} | ${SITE.tagline}`;
const canonical = new URL(Astro.url.pathname, Astro.site ?? SITE.url).href;

const orgSchema = {
  '@context': 'https://schema.org',
  '@type': 'GeneralContractor',
  name: SITE.name,
  description: SITE.shortDesc,
  url: SITE.url,
  foundingDate: String(SITE.foundedYear),
  founder: { '@type': 'Person', name: SITE.founder },
  areaServed: 'Madhya Pradesh, India',
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'Mhow–Neemuch Road, In front of DRP Lines',
    addressLocality: 'Mandsaur',
    addressRegion: 'MP',
    postalCode: '458001',
    addressCountry: 'IN',
  },
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href={url('/favicon.svg')} />
    <meta name="generator" content={Astro.generator} />

    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(url(image), Astro.site ?? SITE.url).href} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />

    <meta name="theme-color" content="#0e2138" />

    <!-- Enable reveal animations only when JS is running (content stays visible otherwise). -->
    <script is:inline>
      document.documentElement.classList.add('reveal-on');
    </script>

    <script type="application/ld+json" set:html={JSON.stringify(orgSchema)} />
  </head>
  <body>
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:rounded-md focus:bg-brand-900 focus:px-4 focus:py-2 focus:text-white"
      >Skip to content</a
    >
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />

    <script>
      // Reveal-on-scroll. Scroll-position based (not IntersectionObserver) so that
      // fast scrolls can never leave a section permanently hidden — every scroll
      // re-checks any element not yet revealed.
      (() => {
        const reveal = () => {
          const trigger = window.innerHeight - 60;
          document.querySelectorAll('.reveal:not(.is-visible)').forEach((el) => {
            if (el.getBoundingClientRect().top < trigger) el.classList.add('is-visible');
          });
        };
        reveal();
        let ticking = false;
        const onScroll = () => {
          if (ticking) return;
          ticking = true;
          requestAnimationFrame(() => {
            reveal();
            ticking = false;
          });
        };
        window.addEventListener('scroll', onScroll, { passive: true });
        window.addEventListener('resize', onScroll, { passive: true });
        window.addEventListener('load', reveal);
        // Safety net: never leave content hidden, even on unusual scroll behaviour.
        setTimeout(() => {
          document.querySelectorAll('.reveal:not(.is-visible)').forEach((el) => {
            if (el.getBoundingClientRect().top < window.innerHeight) el.classList.add('is-visible');
          });
        }, 2500);
      })();
    </script>
  </body>
</html>
