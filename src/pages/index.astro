---
import Layout from '../layouts/Layout.astro';
import Button from '../components/Button.astro';
import Icon from '../components/Icon.astro';
import Stats from '../components/Stats.astro';
import SectionHeading from '../components/SectionHeading.astro';
import ProjectCard from '../components/ProjectCard.astro';
import CTA from '../components/CTA.astro';
import { PROJECTS, VALUES, CLIENTS } from '../data/content';
import { SITE } from '../consts';
import { url } from '../lib/url';

const featuredProjects = PROJECTS.slice(0, 4);
const trust = ['MoRTH-grade quality', 'MPRRDA & PWD empanelled', '170+ workforce', 'In-house plant & fleet'];

// The four home-page photos with the captions supplied by the client.
const showcase = [
  {
    img: '/images/road-aerial.webp',
    caption: 'Not Just Roads — Precision-Built Pathways of Strength',
    sub: 'Finished carriageways engineered for safety and a long service life.',
  },
  {
    img: '/images/plant-night.webp',
    caption: 'Operational Excellence, Day and Night',
    sub: 'Round-the-clock production keeps our projects on schedule.',
  },
  {
    img: '/images/earthwork.webp',
    caption: 'Laying the Ground for What is to Come',
    sub: 'Earthwork and formation built to exacting engineering standards.',
  },
  {
    img: '/images/production.webp',
    caption: 'Our Backbone: Reliable In-House Production',
    sub: 'Owned crushing, batching and hot-mix plants control our quality.',
  },
];
---
<Layout>
  <!-- ============================ HERO ============================ -->
  <section class="relative isolate overflow-hidden bg-brand-950 text-white">
    <img
      src={url('/images/road-aerial.webp')}
      alt="Aerial view of a completed divided road built by Gupta Enterprises"
      class="absolute inset-0 h-full w-full object-cover"
      fetchpriority="high"
    />
    <div class="absolute inset-0 bg-gradient-to-r from-brand-950 via-brand-950/85 to-brand-950/40"></div>
    <div class="absolute inset-0 bg-grid opacity-25"></div>

    <div class="container-x relative py-24 lg:py-32">
      <div class="max-w-2xl">
        <p class="inline-flex items-center gap-2 rounded-full border border-white/15 bg-white/5 px-4 py-1.5 text-sm font-medium text-accent-300 backdrop-blur">
          <span class="h-2 w-2 rounded-full bg-accent-500"></span>
          Not Just Roads — Precision-Built Pathways of Strength
        </p>
        <h1 class="mt-6 text-4xl font-bold leading-[1.05] tracking-tight text-balance sm:text-5xl lg:text-6xl">
          Building the roads that move
          <span class="text-accent-400"> Madhya Pradesh </span>
          forward.
        </h1>
        <p class="mt-6 max-w-xl text-lg leading-relaxed text-brand-100">
          From a first-generation start in Mandsaur to one of the region’s most
          technically proficient contractors — Gupta Enterprises delivers highways,
          RCC roads, rural connectivity and turnkey EPC projects built to last.
        </p>
        <div class="mt-8 flex flex-col gap-3 sm:flex-row">
          <Button href="/projects/" variant="primary" size="lg" arrow>View Our Projects</Button>
          <Button href="/contact/" variant="white" size="lg">Request a Quote</Button>
        </div>
        <ul class="mt-10 grid grid-cols-2 gap-x-6 gap-y-3 sm:grid-cols-4">
          {trust.map((t) => (
            <li class="flex items-center gap-2 text-sm text-brand-100">
              <Icon name="check" class="h-4 w-4 shrink-0 text-accent-400" />{t}
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- ============================ STATS ============================ -->
  <section class="relative bg-white">
    <div class="container-x -translate-y-10">
      <div class="rounded-2xl bg-brand-900 p-1.5 shadow-lift">
        <Stats variant="dark" />
      </div>
    </div>
  </section>

  <!-- ============================ SHOWCASE (captioned photos) ============================ -->
  <section class="bg-white pb-20">
    <div class="container-x">
      <SectionHeading
        align="center"
        eyebrow="On the ground"
        title="Our work, from formation to finish."
        class="mb-12"
      >
        <p>A look at how we build — with owned plant, disciplined execution and round-the-clock effort.</p>
      </SectionHeading>
      <div class="grid gap-5 sm:grid-cols-2">
        {showcase.map((s) => (
          <figure class="reveal group relative overflow-hidden rounded-2xl shadow-card">
            <img
              src={url(s.img)}
              alt={s.caption}
              loading="lazy"
              class="aspect-[16/10] w-full object-cover transition-transform duration-500 group-hover:scale-105"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-brand-950/90 via-brand-950/25 to-transparent"></div>
            <figcaption class="absolute inset-x-0 bottom-0 p-6">
              <h3 class="font-display text-xl font-bold text-white text-balance">{s.caption}</h3>
              <p class="mt-1.5 text-sm text-brand-100">{s.sub}</p>
            </figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>

  <!-- ============================ ABOUT TEASER ============================ -->
  <section class="bg-slate-50 py-20">
    <div class="container-x grid gap-12 lg:grid-cols-2 lg:items-center">
      <div class="reveal">
        <div class="relative">
          <img
            src={url('/images/plant-night.webp')}
            alt="Gupta Enterprises concrete batching plant operating at night"
            loading="lazy"
            class="aspect-[4/3] w-full rounded-2xl object-cover shadow-lift"
          />
          <div class="absolute -bottom-6 -left-4 rounded-2xl bg-accent-500 p-6 text-brand-950 shadow-lift sm:-left-6">
            <p class="font-display text-3xl font-bold">23+</p>
            <p class="mt-1 text-sm font-medium">Years building MP’s roads</p>
          </div>
          <div class="absolute -right-4 -top-6 hidden rounded-2xl border border-slate-200 bg-white p-5 shadow-lift sm:block">
            <div class="flex items-center gap-3">
              <Icon name="users" class="h-7 w-7 text-brand-700" />
              <div>
                <p class="font-display text-lg font-bold text-brand-900">From 30 to 170+</p>
                <p class="text-xs text-slate-500">A team grown on reliable delivery</p>
              </div>
            </div>
          </div>
        </div>
      </div>

      <div class="reveal">
        <SectionHeading eyebrow="Who we are" title="A Mandsaur contractor with a reputation for getting it right.">
          <p>
            Founded in 2001 by {SITE.founder} as a first-generation entrepreneur,
            Gupta Enterprises began with small-scale works and a team of around 30.
            Today we are recognised as one of the most technically proficient and
            productive construction firms in the region.
          </p>
        </SectionHeading>
        <div class="mt-8 grid gap-4 sm:grid-cols-2">
          {VALUES.map((v) => (
            <div class="flex gap-3">
              <Icon name="check" class="mt-1 h-5 w-5 shrink-0 text-accent-600" />
              <div>
                <p class="font-semibold text-brand-900">{v.title}</p>
                <p class="mt-1 text-sm text-slate-600">{v.description}</p>
              </div>
            </div>
          ))}
        </div>
        <div class="mt-8">
          <Button href="/about/" variant="secondary" arrow>More about us</Button>
        </div>
      </div>
    </div>
  </section>

  <!-- ============================ PROJECTS ============================ -->
  <section class="bg-white py-20 lg:py-24">
    <div class="container-x">
      <div class="flex flex-col items-end justify-between gap-6 sm:flex-row">
        <SectionHeading eyebrow="Selected work" title="Projects that connect communities.">
          <p>A snapshot of highways, rural roads, EPC packages and industrial civil works delivered across Madhya Pradesh.</p>
        </SectionHeading>
        <Button href="/projects/" variant="ghost" arrow class="shrink-0">All projects</Button>
      </div>
      <div class="mt-12 grid gap-6 sm:grid-cols-2">
        {featuredProjects.map((p) => <ProjectCard project={p} />)}
      </div>
    </div>
  </section>

  <!-- ============================ CLIENTS ============================ -->
  <section class="border-y border-slate-200 bg-slate-50 py-14">
    <div class="container-x">
      <p class="text-center text-sm font-semibold uppercase tracking-wider text-slate-500">
        Trusted by government bodies & authorities across the region
      </p>
      <div class="mt-8 grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-6">
        {CLIENTS.map((c) => (
          <div class="flex flex-col items-center justify-center rounded-xl border border-slate-200 bg-white px-3 py-5 text-center">
            <span class="font-display text-xl font-bold text-brand-800">{c.abbr}</span>
            <span class="mt-1 text-[0.7rem] leading-tight text-slate-500">{c.name}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <CTA />
</Layout>
