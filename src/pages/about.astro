---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import SectionHeading from '../components/SectionHeading.astro';
import Icon from '../components/Icon.astro';
import Stats from '../components/Stats.astro';
import CTA from '../components/CTA.astro';
import { VALUES, TIMELINE } from '../data/content';
import { SITE } from '../consts';
---
<Layout
  title="About Us"
  description="The story of Gupta Enterprises — a Mandsaur infrastructure company built from the ground up since 2001 into one of the region's most technically proficient road contractors."
>
  <PageHeader
    crumb="About"
    title="From a team of 30 to one of the region’s most trusted contractors."
    subtitle="The story of Gupta Enterprises is one of disciplined growth, technical pride and roads that connect Madhya Pradesh."
  />

  <!-- Story -->
  <section class="bg-white py-20">
    <div class="container-x grid gap-12 lg:grid-cols-12 lg:gap-16">
      <div class="lg:col-span-7">
        <SectionHeading eyebrow="Our story" title="Built in Mandsaur, proven across Madhya Pradesh." />
        <div class="mt-6 space-y-4 text-base leading-relaxed text-slate-600">
          <p>
            Gupta Enterprises was founded in {SITE.foundedYear} by {SITE.founder}, a
            first-generation entrepreneur who started with small-scale projects and a
            workforce of just 30 people — including early civil works in collaboration
            with BSNL.
          </p>
          <p>
            A significant breakthrough came in 2014–15, when the company was entrusted
            with constructing rural roads under the MPRRDA and PIU Mandsaur. That
            mandate scaled our capability, our fleet and our reputation for delivering
            all-weather connectivity to villages across the region.
          </p>
          <p>
            In FY 2022–23, Gupta Enterprises completed a significant EPC order for the
            Public Works Department <strong class="text-brand-900">six months ahead of
            schedule</strong> — a milestone that reflects how we plan, resource and
            execute every package we take on.
          </p>
          <p>
            Today, with a workforce of over 170 skilled individuals, Gupta Enterprises
            is recognised as one of the most technically proficient and productive
            construction companies in the region.
          </p>
        </div>
      </div>

      <aside class="lg:col-span-5">
        <div class="sticky top-28 space-y-4">
          <div class="rounded-2xl border border-slate-200 bg-slate-50 p-7">
            <h3 class="font-display text-lg font-bold text-brand-900">At a glance</h3>
            <dl class="mt-5 space-y-4 text-sm">
              <div class="flex justify-between gap-4 border-b border-slate-200 pb-3">
                <dt class="text-slate-500">Founded</dt>
                <dd class="font-semibold text-brand-900">{SITE.foundedYear}</dd>
              </div>
              <div class="flex justify-between gap-4 border-b border-slate-200 pb-3">
                <dt class="text-slate-500">Founder</dt>
                <dd class="font-semibold text-brand-900">{SITE.founder}</dd>
              </div>
              <div class="flex justify-between gap-4 border-b border-slate-200 pb-3">
                <dt class="text-slate-500">Headquarters</dt>
                <dd class="text-right font-semibold text-brand-900">Mandsaur, MP</dd>
              </div>
              <div class="flex justify-between gap-4 border-b border-slate-200 pb-3">
                <dt class="text-slate-500">Workforce</dt>
                <dd class="font-semibold text-brand-900">170+</dd>
              </div>
              <div class="flex justify-between gap-4">
                <dt class="text-slate-500">Specialisation</dt>
                <dd class="text-right font-semibold text-brand-900">Roads & EPC</dd>
              </div>
            </dl>
          </div>
          <div class="rounded-2xl bg-brand-900 p-7 text-white">
            <Icon name="shield" class="h-8 w-8 text-accent-400" />
            <p class="mt-3 font-display text-lg font-bold">Our promise</p>
            <p class="mt-2 text-sm leading-relaxed text-brand-100">
              Quality on every layer, safety on every site, and delivery you can plan
              your schedule around.
            </p>
          </div>
        </div>
      </aside>
    </div>
  </section>

  <!-- Mission / Vision -->
  <section class="bg-slate-50 py-20">
    <div class="container-x grid gap-6 md:grid-cols-2">
      <div class="rounded-2xl border border-slate-200 bg-white p-8">
        <div class="inline-flex h-12 w-12 items-center justify-center rounded-xl bg-brand-50 text-brand-700">
          <Icon name="arrow" class="h-6 w-6" />
        </div>
        <h3 class="mt-5 text-2xl font-bold text-brand-900">Our Mission</h3>
        <p class="mt-3 leading-relaxed text-slate-600">
          To build durable, safe and high-quality road infrastructure that connects
          communities and accelerates the growth of Madhya Pradesh — delivered on time,
          on budget and to the highest engineering standards.
        </p>
      </div>
      <div class="rounded-2xl border border-slate-200 bg-white p-8">
        <div class="inline-flex h-12 w-12 items-center justify-center rounded-xl bg-accent-100 text-accent-700">
          <Icon name="star" class="h-6 w-6" />
        </div>
        <h3 class="mt-5 text-2xl font-bold text-brand-900">Our Vision</h3>
        <p class="mt-3 leading-relaxed text-slate-600">
          To be Central India’s most trusted infrastructure partner — known for
          technical excellence, dependable delivery and a lasting positive impact on the
          regions and people we serve.
        </p>
      </div>
    </div>
  </section>

  <!-- Values -->
  <section class="bg-white py-20">
    <div class="container-x">
      <SectionHeading
        align="center"
        eyebrow="What drives us"
        title="The values behind every kilometre."
        class="mb-12"
      />
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {VALUES.map((v, i) => (
          <div class="reveal rounded-2xl border border-slate-200 bg-slate-50 p-6">
            <span class="font-display text-3xl font-bold text-accent-500">0{i + 1}</span>
            <h3 class="mt-3 text-lg font-bold text-brand-900">{v.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-slate-600">{v.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Timeline -->
  <section class="bg-brand-950 py-20 text-white">
    <div class="container-x">
      <SectionHeading
        light
        align="center"
        eyebrow="Our journey"
        title="Two decades of building forward."
        class="mb-14"
      />
      <ol class="relative mx-auto max-w-3xl border-l border-white/15 pl-8">
        {TIMELINE.map((m) => (
          <li class="reveal mb-10 last:mb-0">
            <span class="absolute -left-[9px] mt-1.5 h-4 w-4 rounded-full border-2 border-brand-950 bg-accent-500"></span>
            <span class="font-display text-sm font-bold uppercase tracking-wider text-accent-400">{m.year}</span>
            <h3 class="mt-1 text-xl font-bold">{m.title}</h3>
            <p class="mt-2 leading-relaxed text-brand-100">{m.description}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- Stats -->
  <section class="bg-white py-20">
    <div class="container-x">
      <Stats variant="light" />
    </div>
  </section>

  <CTA />
</Layout>
