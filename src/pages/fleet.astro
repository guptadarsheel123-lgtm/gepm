---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import SectionHeading from '../components/SectionHeading.astro';
import Icon from '../components/Icon.astro';
import CTA from '../components/CTA.astro';
import { EQUIPMENT } from '../data/content';

const capabilities = [
  { title: 'In-house production', text: 'Owning our hot-mix, batching and crushing plants means consistent material quality and no dependency on third parties.' },
  { title: 'Self-sufficient fleet', text: 'A full spread of earthmoving, paving and compaction machinery keeps projects on schedule.' },
  { title: 'Maintained & ready', text: 'Regular servicing and skilled operators maximise uptime across every site.' },
];

const strength = [
  { count: '11', label: 'Excavators' },
  { count: '30', label: 'Tippers / Dumpers' },
  { count: 'In-house', label: 'Hot-mix · Batching · Crushing plants' },
];
---
<Layout
  title="Fleet"
  description="Gupta Enterprises operates an owned fleet of 11 excavators, 30 tippers, pavers, batching, hot-mix and crushing plants — the backbone of on-time delivery."
>
  <PageHeader
    crumb="Fleet"
    title="An owned fleet built for on-time delivery."
    subtitle="Self-sufficiency in plant and machinery is how we control quality and hold our schedules."
  />

  <!-- Fleet strength -->
  <section class="relative -mt-10 bg-white">
    <div class="container-x">
      <div class="grid grid-cols-1 gap-px overflow-hidden rounded-2xl bg-white/10 shadow-lift sm:grid-cols-3">
        {strength.map((s) => (
          <div class="flex flex-col items-center justify-center bg-brand-900 px-4 py-8 text-center">
            <span class="font-display text-4xl font-bold text-accent-400 sm:text-5xl">{s.count}</span>
            <span class="mt-2 text-sm font-medium text-brand-100">{s.label}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Capabilities -->
  <section class="bg-white py-20">
    <div class="container-x grid gap-6 md:grid-cols-3">
      {capabilities.map((c) => (
        <div class="reveal rounded-2xl border border-slate-200 bg-slate-50 p-7">
          <div class="inline-flex h-12 w-12 items-center justify-center rounded-xl bg-brand-900 text-accent-400">
            <Icon name="shield" class="h-6 w-6" />
          </div>
          <h3 class="mt-4 text-lg font-bold text-brand-900">{c.title}</h3>
          <p class="mt-2 text-sm leading-relaxed text-slate-600">{c.text}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- Fleet grid -->
  <section class="bg-slate-50 py-20">
    <div class="container-x">
      <SectionHeading
        eyebrow="Plant & machinery"
        title="Our core equipment."
        class="mb-12"
      >
        <p>A representative list of the machinery we deploy across road and infrastructure projects.</p>
      </SectionHeading>
      <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
        {EQUIPMENT.map((e) => (
          <div class="reveal group flex flex-col rounded-2xl border border-slate-200 bg-white p-6 transition-all hover:-translate-y-1 hover:shadow-lift">
            <div class="relative flex aspect-video items-center justify-center rounded-xl bg-gradient-to-br from-brand-700 to-brand-950 bg-grid">
              <Icon name="maintenance" class="h-10 w-10 text-white/25" />
              {e.count && (
                <span class="absolute right-3 top-3 rounded-full bg-accent-500 px-2.5 py-1 text-xs font-bold text-brand-950">
                  {e.count} nos.
                </span>
              )}
            </div>
            <h3 class="mt-4 font-bold text-brand-900">{e.name}</h3>
            <p class="mt-1 text-sm text-slate-600">{e.purpose}</p>
          </div>
        ))}
      </div>
      <p class="mt-8 text-sm text-slate-500">
        Fleet composition varies by project. Detailed equipment schedules are available on request.
      </p>
    </div>
  </section>

  <CTA />
</Layout>
